---
import '../styles/global.css';
import Topbar from '../components/Topbar.astro';
import PitchAgent from '../components/islands/PitchAgent.tsx';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  activeRoute?: 'overview' | 'systems' | 'experience' | 'writing' | 'contact';
  ogImage?: string;
}
const { title, description, activeRoute, ogImage = 'og-default.png' } = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogUrl = Astro.site ? new URL(withBase(ogImage), Astro.site).href : withBase(ogImage);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="preload" as="font" type="font/woff2" href={withBase('fonts/inter-variable.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={withBase('fonts/jetbrains-mono-variable.woff2')} crossorigin />
  </head>
  <body>
    <Topbar activeRoute={activeRoute} />
    <main>
      <slot />
    </main>
    <PitchAgent client:idle />
  </body>
</html>
