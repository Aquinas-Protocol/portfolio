---
import BaseLayout from '../layouts/BaseLayout.astro';
import FrequencyTile from '../components/FrequencyTile.astro';
import PitchAgent from '../components/islands/PitchAgent.tsx';
import { profile, channels } from '../lib/content';

const a = profile.availability;
const cm = profile.contactMeta;
---
<BaseLayout
  title="Contact — Dylan Palumbo"
  description="Talk to AI Dylan, an assistant trained on my public work — or reach me by email, LinkedIn, GitHub, calendar, or resume. Open to senior IC roles in AI infra, platform, and SRE."
  activeRoute="contact"
>
  <div class="wrap" style="padding-top:36px;padding-bottom:80px">
    <div class="bHero">
      <div>
        <div class="stampLine">{cm.stamp}</div>
        <h1 class="pageTitle">Hailing <span class="grad">frequencies</span><br>open.</h1>
        <div class="ledeText">{cm.lede}</div>
      </div>
      <div class="right">
        <span set:html={`ALL CHANNELS · <b>${cm.allChannels}</b>`}></span>
        <span set:html={`FASTEST · <b>${cm.fastest}</b>`}></span>
        <span set:html={`BEST FIRST CONTACT · <b>${cm.bestFirst}</b>`}></span>
      </div>
    </div>

    <section class="agentFeature">
      <div class="afCopy">
        <div class="stampLine">// TALK TO THE SYSTEM</div>
        <h2 class="afTitle">Ask <span class="grad">AI&nbsp;Dylan</span></h2>
        <p class="afLede">An assistant trained on my public work. Ask it anything, or use it for a quick read on:</p>
        <ul class="afList">
          <li><b>What I've built</b>, and how it actually works</li>
          <li><b>Whether I'm a fit</b> for a given role</li>
          <li><b>Availability</b> and how to reach me</li>
        </ul>
        <a class="afProof" href="https://github.com/Aquinas-Protocol/portfolio">See how this chat is built · github.com/Aquinas-Protocol/portfolio →</a>
      </div>
      <div class="afChat">
        <PitchAgent variant="inline" client:visible />
      </div>
    </section>

    <div class="freqGrid">
      {channels.map((ch) => <FrequencyTile ch={ch} />)}
    </div>

    <div class="bottomGrid">
      <div class="quickForm">
        <h2>// QUICK MESSAGE</h2>
        <div class="sub">No form, no middleman. Short and direct works best — I read everything within 24 hours.</div>
        <div style="font-family:var(--mono);font-size:13px;color:var(--text);margin-bottom:16px;word-break:break-all">{profile.handles.email}</div>
        <a class="send" style="display:block;text-align:center;text-decoration:none" href={`mailto:${profile.handles.email}`}>EMAIL ME →</a>
      </div>

      <div class="availPanel">
        <h2>AVAILABILITY · OPEN</h2>
        <div class="big">Open to <span class="grad">senior IC roles</span><br>in AI infra, platform, SRE.</div>
        <div class="meta" set:html={`LOCATION · <b>${a.location}</b><br>ENGAGEMENT · <b>${a.engagement}</b><br>EARLIEST START · <b class="acc">${a.earliestStart}</b><br>CONTRACT · <b>${a.contract}</b><br>VISA · <b>${a.visa}</b>`}></div>
        <div>
          <div style="font-family:var(--mono);font-size:10px;color:var(--purple);letter-spacing:.18em;margin-bottom:8px">// TARGETING</div>
          <div class="targetTags">{a.targetTags.map((t) => <span class="tt">{t}</span>)}</div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
