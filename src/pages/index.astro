---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sparkline from '../components/Sparkline.astro';
import Footer from '../components/Footer.astro';
import FeaturedProjectTabs from '../components/islands/FeaturedProjectTabs.tsx';
import ActivityFeed from '../components/islands/ActivityFeed.tsx';
import { profile, stats, systems } from '../lib/content';
import { withBase } from '../lib/url';

const h = profile.hero;
const op = profile.operator;
const disc = systems.find((s) => s.slug === 'discord-ops')!;

// Featured-system showcase flavor (static, illustrative — NOT live agent data, per §8).
const agents = [
  { name: 'DAEDALUS', role: 'Operator', turns: '1,247', av: '' as const },
  { name: 'INTEL', role: 'Deep Research', turns: '342', av: 'cy' as const },
  { name: 'HERMES', role: 'Correspondence', turns: '198', av: 'am' as const },
];
const chat = [
  { who: 'DAEDALUS', msg: 'Standup ready. Intel pulled 14 articles overnight; Hermes drafted 3 replies for review.' },
  { who: 'INTEL', whoCls: 'cy' as const, msg: 'Brief saved · 14 sources.' },
  { who: 'HERMES', whoCls: 'am' as const, typing: 'drafting reply' },
];
---
<BaseLayout
  title="Dylan Palumbo — Senior IC · AI Infra"
  description="10+ years operating, training, and shipping. Currently shipping production multi-agent AI infrastructure as proof-of-work for senior IC roles."
  activeRoute="overview"
>
  <div class="wrap ovw">
    <!-- HERO -->
    <section class="hero">
      <div>
        <div class="stamp">{h.stamp}</div>
        <h1>{h.headPre}<span class="grad">{h.headGrad}</span>{h.headPost}<span class="cursor" aria-hidden="true"></span></h1>
        <div class="sub" set:html={h.sub}></div>
        <div class="cta">
          <a class="btn primary" href={withBase(profile.handles.resume)}>VIEW RESUME →</a>
          <a class="btn" href={profile.handles.github}>GITHUB · AQUINAS-PROTOCOL</a>
          <a class="btn" href={`mailto:${profile.handles.email}`}>EMAIL</a>
        </div>
        <div class="quickmeta">
          <span>LOC · <b>{profile.location}</b></span>
          <span>{profile.yearsExperience} YRS · <b>{profile.focus}</b></span>
          <span>STATUS · <b>{profile.availabilityLabel}</b></span>
        </div>
      </div>

      <div class="opCluster">
        <div class="ocHead"><span>{op.fileNo}</span><span>{op.idCode}</span></div>
        <div class="ocFig">
          <div class="glow" aria-hidden="true"></div>
          <img src={withBase('headshot-cutout.webp')} alt="Dylan Palumbo — headshot" width="1179" height="1200" loading="eager" fetchpriority="high" decoding="async" />
        </div>
        <div class="ocCells">
          {op.cells.map((c, i) => (
            <div class={`ocCell ${['tl','tr','bl','br'][i]}`}>
              <div class="k">{c.k}</div><div class={`v ${c.tone ?? ''}`}>{c.v}</div>
            </div>
          ))}
        </div>
        <div class="ocStatus">
          <span class="live"><span class="dot" aria-hidden="true"></span>{op.statusLeft}</span>
          <span>{op.statusRight}</span>
        </div>
      </div>
    </section>

    <!-- KPI STRIP -->
    <section class="strip">
      {stats.map((s) => (
        <div class="kpi">
          <div class="k">{s.k}</div>
          <div class="v">{s.v}</div>
          <div class={`t ${s.tClass}`}>{s.t}</div>
          <Sparkline stroke={s.spark.stroke} points={s.spark.points} />
        </div>
      ))}
    </section>

    <!-- FEATURED SYSTEM -->
    <section class="sect">
      <h2 class="sectHead">// FEATURED SYSTEM</h2>
      <div class="lede"><em>The site is the dashboard, the dashboard is the work.</em> discord-ops is the production agent infrastructure powering this page.</div>
      <div class="feature">
        <div class="fLeft">
          <div class="badgeRow">
            <span class="badge live">LIVE · v2.7.7A</span>
            <span class="badge pur">6 AGENTS</span>
            <span class="badge cy">PYTHON 3.12</span>
          </div>
          <h3>{disc.name}</h3>
          <p class="desc">{disc.detail.sub}</p>
          <div class="stack">
            <span class="chip">Python</span><span class="chip">FastAPI</span><span class="chip">SQLite</span>
            <span class="chip">Claude Agent SDK</span><span class="chip">MCP</span><span class="chip">discord.py</span>
          </div>
          <div class="statsMini">
            <div class="s"><div class="k">Tests</div><div class="v g">1,069 ✓</div></div>
            <div class="s"><div class="k">Uptime</div><div class="v g">99.94%</div></div>
            <div class="s"><div class="k">Status</div><div class="v c">PROD</div></div>
          </div>
        </div>
        <FeaturedProjectTabs client:visible agents={agents} chat={chat} />
      </div>
    </section>

    <!-- ACTIVE SYSTEMS -->
    <section class="sect">
      <h2 class="sectHead">// ACTIVE SYSTEMS</h2>
      <div class="lede">Open-source, vault, and operational work — each rendered as its own surface.</div>
      <div class="pGrid">
        <a class="pCard" href="https://github.com/Aquinas-Protocol/domo" target="_blank" rel="noopener noreferrer" style="text-decoration:none;color:inherit">
          <h3><span>Domo <span style="color:var(--dim);font-weight:400">↗</span></span> <span class="badge live" style="font-size:8px">v0.1.0</span></h3>
          <div class="d">MIT-licensed standalone extraction of discord-ops. Plugin seam, wizard installer, sanitized history.</div>
          <div class="miniBox">
            <div class="mh"><span>// SCHEDULED JOBS</span><span>3 / 6 ACTIVE</span></div>
            <div style="font-family:var(--mono);font-size:11px;display:flex;flex-direction:column;gap:8px;flex:1">
              <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 10px;background:var(--panel);border:1px solid var(--border-2);border-radius:6px"><span>daily-standup</span><span style="color:var(--cyan);font-size:10px">06:00 UTC</span></div>
              <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 10px;background:var(--panel);border:1px solid var(--border-2);border-radius:6px"><span>memory-consolidate</span><span style="color:var(--cyan);font-size:10px">03:00 UTC</span></div>
              <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 10px;background:var(--panel);border:1px solid var(--border-2);border-radius:6px;opacity:.7"><span>research-brief</span><span style="color:var(--dim);font-size:10px">22:00 UTC</span></div>
            </div>
          </div>
        </a>

        <a class="pCard" href="https://aquinas-protocol.github.io/second-brain/" target="_blank" rel="noopener noreferrer" style="text-decoration:none;color:inherit">
          <h3><span>second-brain <span style="color:var(--dim);font-weight:400">↗</span></span> <span class="badge pur" style="font-size:8px">VAULT</span></h3>
          <div class="d">Living knowledge vault. raw/ sources, Claude-curated wiki/, append-only log.</div>
          <div class="miniBox">
            <div class="mh"><span>// VAULT TELEMETRY</span><span>OSS · PUBLIC</span></div>
            <div class="gauges">
              <div class="g"><div class="gaugeRing"><svg viewBox="0 0 42 42" width="42" height="42"><circle cx="21" cy="21" r="17" fill="none" stroke="#202637" stroke-width="4"/><circle cx="21" cy="21" r="17" fill="none" stroke="#9d7cff" stroke-width="4" stroke-dasharray="83.4 106.8" stroke-linecap="round"/></svg></div><div class="gtext"><div class="k">PAGES</div><div class="v">217</div></div></div>
              <div class="g"><div class="gaugeRing"><svg viewBox="0 0 42 42" width="42" height="42"><circle cx="21" cy="21" r="17" fill="none" stroke="#202637" stroke-width="4"/><circle cx="21" cy="21" r="17" fill="none" stroke="#4ddbe6" stroke-width="4" stroke-dasharray="98.4 106.8" stroke-linecap="round"/></svg></div><div class="gtext"><div class="k">SOURCES</div><div class="v">1,432</div></div></div>
              <div class="g"><div class="gaugeRing"><svg viewBox="0 0 42 42" width="42" height="42"><circle cx="21" cy="21" r="17" fill="none" stroke="#202637" stroke-width="4"/><circle cx="21" cy="21" r="17" fill="none" stroke="#5ee892" stroke-width="4" stroke-dasharray="57.6 106.8" stroke-linecap="round"/></svg></div><div class="gtext"><div class="k">PROJECTS</div><div class="v">14</div></div></div>
              <div class="g"><div class="gaugeRing"><svg viewBox="0 0 42 42" width="42" height="42"><circle cx="21" cy="21" r="17" fill="none" stroke="#202637" stroke-width="4"/><circle cx="21" cy="21" r="17" fill="none" stroke="#ffb44d" stroke-width="4" stroke-dasharray="94.0 106.8" stroke-linecap="round"/></svg></div><div class="gtext"><div class="k">FRESH</div><div class="v">88%</div></div></div>
            </div>
          </div>
        </a>

        <a class="pCard" href={withBase('experience')} style="text-decoration:none;color:inherit">
          <h3><span>EOS · AMER Ops <span style="color:var(--dim);font-weight:400">→</span></span> <span class="badge cy" style="font-size:8px">2025–26</span></h3>
          <div class="d">Led regional IT service delivery — 3 countries, 13 MSP reports, 12,838 users.</div>
          <div class="miniBox">
            <div class="mh"><span>// SLA PERFORMANCE</span><span>AUG 2025 – MAY 2026</span></div>
            <div class="bars">
              <div class="b"><div class="row"><span>CSAT</span><b>95.3%</b></div><div class="track"><div class="fill" style="width:95.3%"></div></div></div>
              <div class="b"><div class="row"><span>TTFR SLA</span><b>98.6%</b></div><div class="track"><div class="fill" style="width:98.6%"></div></div></div>
              <div class="b"><div class="row"><span>TTR SLA</span><b>91.1%</b></div><div class="track"><div class="fill" style="width:91.1%"></div></div></div>
              <div class="b"><div class="row"><span>AUDIT</span><b>100%</b></div><div class="track"><div class="fill" style="width:100%"></div></div></div>
            </div>
          </div>
        </a>
      </div>
    </section>

    <!-- LIVE TELEMETRY -->
    <section class="sect" id="live-telemetry">
      <h2 class="sectHead">// LIVE TELEMETRY</h2>
      <div class="lede">Recent public activity from Aquinas-Protocol — commits, releases, and scheduled-job markers.</div>
      <div class="activity">
        <div class="actLeft">
          <h3>RECENT ACTIVITY</h3>
          <div class="summary">Public GitHub activity across <em>domo</em>, <em>second-brain</em>, and this site, plus templated scheduled-job markers. Sanitized server-side — no private repos, paths, or identities.</div>
          <div class="actStats">
            <div class="ast"><div class="k">Public repos</div><div class="v">9</div></div>
            <div class="ast"><div class="k">OSS shipped</div><div class="v">2</div></div>
            <div class="ast"><div class="k">Feed source</div><div class="v" style="font-size:13px">GitHub</div></div>
            <div class="ast"><div class="k">Refresh</div><div class="v" style="font-size:13px">~5 min</div></div>
          </div>
        </div>
        <div class="actRight">
          <div class="actScroll">
            <ActivityFeed client:visible />
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</BaseLayout>
